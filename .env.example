# Copy to .env for local use, or set these as environment variables on the host
# (Railway / Render / Fly). EVERY security var is OPTIONAL: if unset, that gate is
# OPEN, so local development behaves exactly like before. Set them in production.

# --- Security -------------------------------------------------------------------
# Guards the read-only JSON API (/api/v1/*). The Next.js SERVER holds this and sends
# it as `Authorization: Bearer <key>` (or `X-API-Key`); it must never reach the browser
# (do NOT prefix it NEXT_PUBLIC_). Generate a long random value.
API_KEY=

# Guards the MUTATING settings API (/api/v1/admin/*) that the frontend's admin panel
# drives. Same header, but a DIFFERENT value: holding the read key must not confer the
# ability to rewrite the weights, thresholds and provider keys, and the two should
# rotate independently.
#
# Unlike the vars above this one FAILS CLOSED - leave it unset and the admin API
# returns 503. That is deliberate: an unset API_KEY only leaves a score readable,
# whereas an unset admin key would hand the engine to anyone who found the URL.
ADMIN_API_KEY=

# HTTP Basic login for the Jinja admin/testing UI (/, /history, /settings, /run-*).
# Both must be set to enable the gate.
ADMIN_USER=
ADMIN_PASS=

# Comma-separated CORS allowlist for browser calls from the frontend, e.g.
# https://your-app.vercel.app,https://www.your-domain.com
FRONTEND_ORIGINS=

# Per-IP rate limits as "MAX/WINDOW_SECONDS" (optional; sensible defaults built in).
# admin     = the browser/admin UI + auth attempts (brute-force defence, keep it tight).
# api       = /api/v1/* (kept generous: real traffic shares the frontend server's IPs).
# admin_api = /api/v1/admin/* - must not inherit the generous `api` bucket just for
#             living under /api/, but the settings panel polls a running job every
#             couple of seconds, so the tight `admin` one is too tight.
RATELIMIT_ADMIN=30/60
RATELIMIT_API=240/60
RATELIMIT_ADMIN_API=60/60

# --- Data -----------------------------------------------------------------------
# Point the live SQLite DB at a persistent volume (container disks are ephemeral).
# e.g. mount a volume at /data and set: TRADESCALE_DB=/data/tradescale.db
TRADESCALE_DB=

# --- Providers ------------------------------------------------------------------
# Optional: enables GPT news scoring. Preferred over storing a key via the UI.
OPENAI_API_KEY=

# --- Server ---------------------------------------------------------------------
# Host injects PORT; HOST defaults to 0.0.0.0. Override only if needed.
# PORT=8000
# HOST=0.0.0.0
